# ===================================================================
# A comprehensive default .gitignore file.
# For more, see https://github.com/github/gitignore
# ===================================================================

# JetBrains IDEs (IntelliJ, PyCharm, WebStorm, etc.)
# User-specific files
.idea/
*.iws

# Build output
out/

# Gradle cache
.gradle/

# ===================================================================
# IDEs & Editors
# ===================================================================

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ===================================================================
# Operating System Files
# ===================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Trashes
._*
.Spotlight-V100
.fseventsd

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ===================================================================
# Dependencies & Package Managers
# ===================================================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
pnpm-lock.yaml

# Python
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
*.egg
.pytest_cache/
.mypy_cache/

# Java
*.class
*.log
target/
*.jar
*.war
*.ear

# PHP (Composer)
vendor/

# Ruby
vendor/bundle
.bundle/

# ===================================================================
# Sensitive Information & Configuration
# ===================================================================

# Environment variables
# NEVER commit your secrets. Commit a template instead (e.g., .env.example)
.env
.env.*
!.env.example

# Credentials & Secrets
*.pem
*.key
credentials.json
secrets.yml

# Terraform
.terraform/
*.tfstate
*.tfstate.*.backup

# ===================================================================
# General Purpose
# ===================================================================

# Log files
*.log
logs/

# Temporary files
*.tmp
*.bak
*.temp

# Build artifacts
build/
dist/

# Compressed files
*.zip
*.tar.*
*.rar

# Add your project-specific ignores below this line
*config.ini
